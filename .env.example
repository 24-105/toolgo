# 公開サイトの基準URL
NEXT_PUBLIC_SITE_URL=https://toolgo.jp

# 独自ドメインのため空欄
NEXT_PUBLIC_BASE_PATH=

# 未設定ならGoogle Analyticsのスクリプトを読み込まない
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 広告サービスの確認と設定が完了するまでfalseのままにする
NEXT_PUBLIC_ADS_ENABLED=false

# Publisher IDと広告枠IDは発行後にのみ設定する（架空の値を入れない）
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
