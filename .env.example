# 公開サイトの基準URL
NEXT_PUBLIC_SITE_URL=https://toolgo.jp

# 独自ドメインのため空欄
NEXT_PUBLIC_BASE_PATH=

# 未設定ならGoogle Analyticsのスクリプトを読み込まない
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AdSenseを使わない場合はfalseにする
NEXT_PUBLIC_ADS_ENABLED=true

# AdSenseのPublisher ID（公開値）
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-5792181255807252

# 手動配置の広告枠を使う場合だけ設定する
NEXT_PUBLIC_ADSENSE_SLOT_ID=
